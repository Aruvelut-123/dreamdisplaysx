{
  "schemaVersion": 1,
  "id": "dreamdisplayx",
  "name": "Dream DisplaysX",
  "version": "${version}",
  "license": "LGPL-3.0",
  "description": "Create in-game screens to stream videos on any Minecraft server.",
  "authors": [
    "Baymaxawa",
    "arnodoelinger",
    "INotSleep",
    "Kolyakot33",
    "Toffikk"
  ],
  "entrypoints": {
    "client": [
      "com.dreamdisplayx.platform.client.Client"
    ],
    "main": [
      "com.dreamdisplayx.platform.server.Server"
    ],
    "modmenu": [
      "com.dreamdisplayx.platform.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "dreamdisplayx.mixins.json",
    "dreamdisplayx.server.mixins.json"
  ],
  "accessWidener": "dreamdisplayx.classtweaker",
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "minecraft": "${minecraftVersion}",
    "java": ">=${javaVersion}"
  },
  "suggests": {
    "luckperms": "*",
    "modmenu": "*",
    "lambdynlights": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ]
    }
  },
  "icon": "assets/dreamdisplayx/icon.png"
}
